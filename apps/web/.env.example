# ─────────────────────────────────────────────────────────────────────────────
# Variáveis de ambiente do app web ProdScore (Vite)
# Copie este arquivo para .env.local e preencha com os valores reais.
# Variáveis sem o prefixo VITE_ não são expostas ao navegador.
# ─────────────────────────────────────────────────────────────────────────────

# URL do projeto Supabase (encontre em: Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública (anon) do Supabase — pode ser exposta com segurança no frontend
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# URL base da API backend (em desenvolvimento usa o servidor Express local)
VITE_API_URL=http://localhost:3333
