{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "noEmit": true,
    "moduleResolution": "bundler",
    "paths": {
      "@prodscore/shared": ["../../packages/shared/src/index.ts"],
      "@prodscore/shared/constants": ["../../packages/shared/src/constants/gamification.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
