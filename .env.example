# URL do projeto Supabase (encontrado em: Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co

# Chave anônima pública do Supabase (segura para expor no frontend)
SUPABASE_ANON_KEY=your-anon-key-here

# Chave de service role do Supabase (NUNCA expor no frontend — apenas no backend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Segredo para assinar tokens JWT (backend)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Porta do servidor Express
PORT=3333
