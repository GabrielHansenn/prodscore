{
  "name": "prodscore",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=packages/api",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "dev:mobile:tunnel": "npm run start:tunnel --workspace=apps/mobile",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=packages/api",
    "build:shared": "npm run build --workspace=packages/shared",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:vercel": "node scripts/vercel-build.mjs",
    "seed:reset": "npm run build:shared && tsx scripts/reset-and-seed.mts"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": "22.x"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true
  }
}
