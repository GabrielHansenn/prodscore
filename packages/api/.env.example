# ─────────────────────────────────────────────────────────────────────────────
# Variáveis de ambiente da API ProdScore
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA comite o arquivo .env com valores reais para o repositório.
# ─────────────────────────────────────────────────────────────────────────────

# URL do projeto Supabase (encontre em: Project Settings → API → Project URL)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave de serviço do Supabase (service_role) — acesso irrestrito ao banco
# ATENÇÃO: nunca exponha essa chave no frontend ou em logs
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Porta local do servidor Express (padrão: 3333)
PORT=3333

# URL do frontend — usada para configurar o CORS em produção
FRONTEND_URL=http://localhost:5173

# Segredo JWT para assinar tokens personalizados (opcional, se usar JWT próprio)
# JWT_SECRET=um-segredo-aleatorio-e-longo
